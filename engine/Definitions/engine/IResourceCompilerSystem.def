
#include "resourcesystem/iresourcecompiler.h"

native static accessor g_pResourceCompilerSystem as IResourceCompilerSystem
{
	inline bool GenerateResourceFile( string path, void* pData, int size )
	{
		CUtlBuffer inputData( pData, size );
		ResourceCompileSettings_t compileSettings;
		compileSettings.m_pOverrideInputData = &inputData;
		return g_pResourceCompilerSystem->GenerateResourceFile( path, compileSettings );
	}

	inline bool GenerateResourceFile( string path, string text )
	{
		CUtlBuffer inputData( 0, 0, CUtlBuffer::TEXT_BUFFER );
		inputData.PutString( text );
		ResourceCompileSettings_t compileSettings;
		compileSettings.m_pOverrideInputData = &inputData;
		return g_pResourceCompilerSystem->GenerateResourceFile( path, compileSettings );
	}

	inline CUtlBuffer GenerateResourceBytes( string path, void* pData, int size )
	{
		CUtlBuffer inputData;
		inputData.Put( pData, size );

		CUtlBuffer* outputData = new CUtlBuffer();
		
		ResourceCompileSettings_t compileSettings;
		compileSettings.m_pOverrideInputData = &inputData;
		if ( !g_pResourceCompilerSystem->GenerateResourceBytes( path, *outputData, compileSettings ) )
		{
			delete outputData;
			return nullptr;
		}

		return outputData;
	}

	// Content build: compiles one asset into outRoot without compiling its associates (mode 0), only reports
	// what it reads (1), or reports what its current output was built from (2). Returns the build report.
	inline CUtlBuffer GenerateResourceFileForBuild( string path, string outRoot, int mode )
	{
		CUtlBuffer *report = new CUtlBuffer( 0, 0, CUtlBuffer::TEXT_BUFFER );
		report->PutString( "buildreport\t1\n" );
		ResourceCompileSettings_t compileSettings;
		compileSettings.m_nCompileMode = mode == 2 ? COMPILE_AS_NEEDED : COMPILE_PARENTS_AND_CHILDREN_BUT_ASSOCIATES_AS_NEEDED;
		compileSettings.m_pOverrideGameRoot = outRoot;
		compileSettings.m_pBuildReport = report;
		compileSettings.m_bPrerequisitesBuiltByCaller = true;
		compileSettings.m_bDescribeOnly = mode == 1;
		compileSettings.m_bAdoptOnly = mode == 2;
		bool bSuccess = g_pResourceCompilerSystem->GenerateResourceFile( path, compileSettings );
		report->PutString( bSuccess ? "result\t1\n" : "result\t0\n" );
		return report;
	}

	// Content build: the current fingerprint of a special dependency, or -1 if it can't be calculated
	inline long CalculateSpecialDependencyFingerprint( string compiler, string name, uint userData )
	{
		bool bCalculated = false;
		uint32 nFingerprint = g_pResourceCompilerSystem->CalculateSpecialDependencyFingerprint( compiler, name, userData, &bCalculated );
		return bCalculated ? (int64)nFingerprint : -1;
	}

	inline bool GenerateResourceFileForced( string path, string text )
	{
		CUtlBuffer inputData( 0, 0, CUtlBuffer::TEXT_BUFFER );
		inputData.PutString( text );
		ResourceCompileSettings_t compileSettings;
		compileSettings.m_nCompileMode = COMPILE_PARENTS_BUT_CHILDREN_AND_ASSOCIATES_AS_NEEDED;
		compileSettings.m_pOverrideInputData = &inputData;
		return g_pResourceCompilerSystem->GenerateResourceFile( path, compileSettings );
	}
}
