<Project Sdk="Microsoft.NET.Sdk">

	<!--
		Publishes Roslyn precompiled (ReadyToRun) so the engine doesn't have to JIT the compiler the
		first time it compiles code, which costs several seconds in the editor, on joining a game and
		in every test process. SboxBuild's ReadyToRunRoslyn step publishes this for the build machine's
		runtime and copies the results over the IL-only copies NuGet puts in the build output.
		Not part of Sandbox-Engine.slnx. RoslynVersion is passed in so it always matches the engine.
	-->

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<OutputType>Library</OutputType>
		<SelfContained>false</SelfContained>
		<PublishReadyToRun>true</PublishReadyToRun>
		<IsPackable>false</IsPackable>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="$(RoslynVersion)" />
	</ItemGroup>

</Project>
