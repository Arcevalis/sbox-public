@namespace MenuProject.Modals.PackageModalComponents
@inherits Panel
@using Sandbox;
@using Sandbox.UI
@using SboxMenu;
@using static Sandbox.Services.Review

@* The Reviews tab - the verdict up top with a way to write your own (PackageReviewsHeader), what
   players liked and didn't across all of them, then the reviews themselves - all, or just one
   verdict's - a card each, a page of them at a time. *@
<root>

    <PackageReviewsHeader Package=@Package OnWriteReview=@WriteReview />

    @* What they liked, and didn't - each with how many said so *@
    @if ( HasLiked || HasDisliked )
    {
        <div class="tags">
            @if ( HasLiked )
            {
                <div class="tag-group">
                    <div class="eyebrow"><icon>thumb_up</icon><label>Liked</label></div>
                    <div class="chips">
                        @foreach ( var tag in Package.Reviews.PositiveTags.Where( x => x.Value > 0 ).OrderByDescending( x => x.Value ) )
                        {
                            var di = Game.TypeLibrary.GetEnumDescription( tag.Key );
                            <div class="chip good"><icon>@di.Icon</icon><label>@di.Title</label><label class="n">@tag.Value</label></div>
                        }
                    </div>
                </div>
            }

            @if ( HasDisliked )
            {
                <div class="tag-group">
                    <div class="eyebrow bad"><icon>thumb_down</icon><label>Disliked</label></div>
                    <div class="chips">
                        @foreach ( var tag in Package.Reviews.NegativeTags.Where( x => x.Value > 0 ).OrderByDescending( x => x.Value ) )
                        {
                            var di = Game.TypeLibrary.GetEnumDescription( tag.Key );
                            <div class="chip bad"><icon>@di.Icon</icon><label>@di.Title</label><label class="n">@tag.Value</label></div>
                        }
                    </div>
                </div>
            }
        </div>
    }

    @* Which of them - all, or just one verdict's, each with how many there are *@
    @if ( Package.Reviews.Total > 0 )
    {
        <div class="filters">
            <div class="filter @(Filter is null ? "active" : "")" onclick=@( () => _ = SetFilter( null ) )><label>All</label><label class="n">@Package.Reviews.Total</label></div>
            <div class="filter good @(Filter == ReviewScore.Positive ? "active" : "")" onclick=@( () => _ = SetFilter( ReviewScore.Positive ) )><icon>thumb_up</icon><label>Recommended</label><label class="n">@Package.Reviews.PositiveRatings</label></div>
            <div class="filter meh @(Filter == ReviewScore.Promise ? "active" : "")" onclick=@( () => _ = SetFilter( ReviewScore.Promise ) )><icon>thumbs_up_down</icon><label>Shows promise</label><label class="n">@Package.Reviews.PromiseRatings</label></div>
            <div class="filter bad @(Filter == ReviewScore.Negative ? "active" : "")" onclick=@( () => _ = SetFilter( ReviewScore.Negative ) )><icon>thumb_down</icon><label>Needs work</label><label class="n">@Package.Reviews.NegativeRatings</label></div>
        </div>
    }

    <div class="review-list">
        @if ( Reviews.Count == 0 && TotalCount == 0 )
        {
            <div class="no-reviews">@(Filter is null ? "No reviews yet - be the first to write one." : "No reviews like that yet.")</div>
        }
        else
        {
            @foreach ( var review in Reviews )
            {
                <UserComment Player="@review.Player" Date="@review.Updated" TimePlayed="@( $"Played for {review.PlayTime.Humanize(1)}" )" class="@GetReviewClass(review.Score)">
                    <TopBar>
                        @if ( review.Score == ReviewScore.Positive )
                        {
                            <div class="verdict-pill good"><icon>thumb_up</icon><label>Recommended</label></div>
                        }
                        else if ( review.Score == ReviewScore.Negative )
                        {
                            <div class="verdict-pill bad"><icon>thumb_down</icon><label>Needs work</label></div>
                        }
                        else if ( review.Score == ReviewScore.Promise )
                        {
                            <div class="verdict-pill meh"><icon>thumbs_up_down</icon><label>Shows promise</label></div>
                        }
                    </TopBar>
                    <Content>
                        <label class="review-content">@review.Content</label>

                        @if ( review.Positives != Sandbox.Services.Review.PositiveTags.None || review.Negatives != Sandbox.Services.Review.NegativeTags.None )
                        {
                            <div class="chips">
                                @foreach ( var flag in GetPositiveFlags( review.Positives ) )
                                {
                                    var di = Game.TypeLibrary.GetEnumDescription( flag );
                                    <div class="chip good small"><icon>@di.Icon</icon><label>@di.Title</label></div>
                                }
                                @foreach ( var flag in GetNegativeFlags( review.Negatives ) )
                                {
                                    var di = Game.TypeLibrary.GetEnumDescription( flag );
                                    <div class="chip bad small"><icon>@di.Icon</icon><label>@di.Title</label></div>
                                }
                            </div>
                        }
                    </Content>
                </UserComment>
            }

            @* More than a page of them - which one, at the foot *@
            @if ( TotalPages > 1 )
            {
                <div class="pagination">
                    <div class="page-button @(HasPreviousPage ? "" : "disabled")" onclick=@( () => _ = PreviousPage() )><icon>chevron_left</icon></div>
                    @foreach ( var page in GetPageNumbers() )
                    {
                        <div class="page-button @(page == CurrentPage ? "current" : "")" onclick=@( () => _ = GoToPage( page ) )><label>@page</label></div>
                    }
                    <div class="page-button @(HasNextPage ? "" : "disabled")" onclick=@( () => _ = NextPage() )><icon>chevron_right</icon></div>
                </div>
            }
        }
    </div>
</root>

@code
{
    void WriteReview()
    {
        Game.Overlay.ShowReviewModal( Package );
    }

    [Parameter] public Package Package { get; set; }

    bool HasLiked => Package?.Reviews.PositiveTags.Any( x => x.Value > 0 ) ?? false;
    bool HasDisliked => Package?.Reviews.NegativeTags.Any( x => x.Value > 0 ) ?? false;

    List<Sandbox.Services.Review> Reviews = new();

    int CurrentPage = 1;
    int TotalCount = 0;

    /// <summary>
    /// Just the reviews with this verdict - all of them, null.
    /// </summary>
    ReviewScore? Filter;
    const int PageSize = 30;

    int TotalPages => (int)Math.Ceiling( (double)TotalCount / PageSize );
    bool HasPreviousPage => CurrentPage > 1;
    bool HasNextPage => CurrentPage < TotalPages;

    protected override async Task OnParametersSetAsync()
    {
        CurrentPage = 1;
        Filter = null;
        await FetchReviews();
    }

    async Task SetFilter( ReviewScore? filter )
    {
        if ( Filter == filter ) return;
        Filter = filter;
        CurrentPage = 1;
        await FetchReviews();
    }

    async Task FetchReviews()
    {
        var skip = (CurrentPage - 1) * PageSize;
        var page = await Sandbox.Services.Review.FetchEx( Package.FullIdent, PageSize, skip, Filter );
        Reviews = page.Posts?.ToList() ?? new();
        TotalCount = page.Count;
        StateHasChanged();
    }

    async Task GoToPage( int page )
    {
        if ( page < 1 || page > TotalPages || page == CurrentPage ) return;
        CurrentPage = page;
        await FetchReviews();
    }

    async Task PreviousPage() => await GoToPage( CurrentPage - 1 );
    async Task NextPage() => await GoToPage( CurrentPage + 1 );

    IEnumerable<int> GetPageNumbers()
    {
        const int maxVisible = 5;
        int start = Math.Max( 1, CurrentPage - maxVisible / 2 );
        int end = Math.Min( TotalPages, start + maxVisible - 1 );
        start = Math.Max( 1, end - maxVisible + 1 );

        for ( int i = start; i <= end; i++ )
            yield return i;
    }

    static IEnumerable<Sandbox.Services.Review.PositiveTags> GetPositiveFlags( Sandbox.Services.Review.PositiveTags tags )
    {
        foreach ( Sandbox.Services.Review.PositiveTags value in Enum.GetValues( typeof( Sandbox.Services.Review.PositiveTags ) ) )
        {
            if ( value != Sandbox.Services.Review.PositiveTags.None && tags.HasFlag( value ) )
                yield return value;
        }
    }

    static IEnumerable<Sandbox.Services.Review.NegativeTags> GetNegativeFlags( Sandbox.Services.Review.NegativeTags tags )
    {
        foreach ( Sandbox.Services.Review.NegativeTags value in Enum.GetValues( typeof( Sandbox.Services.Review.NegativeTags ) ) )
        {
            if ( value != Sandbox.Services.Review.NegativeTags.None && tags.HasFlag( value ) )
                yield return value;
        }
    }

    string GetReviewClass( Sandbox.Services.Review.ReviewScore score ) => score switch
    {
        Sandbox.Services.Review.ReviewScore.Positive => "positive",
        Sandbox.Services.Review.ReviewScore.Negative => "negative",
        Sandbox.Services.Review.ReviewScore.Promise => "promise",
        _ => ""
    };

    protected override int BuildHash() => HashCode.Combine( Package, Reviews.Count, CurrentPage, TotalCount, Filter );
}
