@using Sandbox
@using Sandbox.UI
@using MenuProject.Modals
@using MenuProject.Modals.PackageModalComponents
@inherits MenuProject.Modals.BaseModal

@*
    One of the game's pages in the pause menu - its changes, news and achievements (off its
    Overview), who's in it with you (off the bar) - in a window over the pause menu, rather than in
    place of it. Escape, a click off
    it or its close button puts it away, back to the Overview under it.
*@
<root>
    <div class="window">
        <div class="head">
            <div class="text">
                <label class="eyebrow">@Package?.Title</label>
                <label class="title">@PackagePage.Find( Page ).Title</label>
            </div>
            <div class="grow"></div>
            <div class="close" onclick=@( () => CloseModal( false ) ) tooltip="Close"><i>close</i></div>
        </div>

        <div class="content" @ref="Content">
            <PackagePage Package=@Package Page=@Page />
        </div>

        @* A real panel after the page, so it draws over it - still while the page scrolls under it. Only
           while there's more of it down there to scroll to *@
        <div class="fade @(MoreBelow ? "shown" : "")"></div>
    </div>
</root>

@code
{
    public Package Package { get; set; }

    Panel Content;

    /// <summary>
    /// The page runs on past the window's foot - the fade says so. Scrolled to the end, or a page that
    /// fits, there's nothing under it to fade, so it's gone and the last of the page is clear.
    /// </summary>
    bool MoreBelow;

    public override void Tick()
    {
        base.Tick();

        if ( !Content.IsValid() ) return;

        var more = Content.ScrollSize.y - Content.ScrollOffset.y > 2;
        if ( more == MoreBelow ) return;

        MoreBelow = more;
        StateHasChanged();
    }

    /// <summary>
    /// Which of the pages it's showing - one of PackagePage's constants.
    /// </summary>
    public string Page { get; set; }

    // Or with menu_mock_player_list on, to look at the list
    public static bool ShowPlayers => MenuProject.Modals.PlayerList.IsMocking || (Networking.IsActive && (PauseModal.CurrentGame?.Info.ShowsPlayerList ?? true));

    /// <summary>
    /// Open one of a game's pages over the pause menu.
    /// </summary>
    public static void Open( Package game, string page )
    {
        ModalSystem.Instance?.Open( new GameInfoModal { Package = game, Page = page } );
    }
}
