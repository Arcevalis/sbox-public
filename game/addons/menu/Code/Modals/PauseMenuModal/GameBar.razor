@using Sandbox
@using Sandbox.UI
@inherits Panel

@*
    Across the top of every page of the pause menu - one big button back to the game, so there's no
    missing how. Everything else you can do about the game is its page's list (GameMenu); quitting
    s&box is the rail's.
*@
<root onclick=@( () => Modal?.Resume() )>

    <i class="play">play_circle</i>

    <div class="text">
        <label class="title">Resume game</label>
        <label class="game">@(ThisGame?.Title ?? Game.Ident)</label>
    </div>

    <div class="grow"></div>

    <i class="go">arrow_forward</i>

</root>

@code
{
    [Parameter] public PauseModal Modal { get; set; }

    static Package ThisGame => PauseModal.CurrentGame;

    protected override int BuildHash() => HashCode.Combine( ThisGame );
}
