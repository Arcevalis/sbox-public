@namespace MenuProject.Modals
@inherits MenuProject.Modals.BaseModal

@using Sandbox;
@using System;
@using Sandbox.UI
@using Sandbox.Mounting
@using Sandbox.UI.Mounts

@using MenuProject.Modals.MapSelect
@using SboxMenu;

@*
    Picking a map - where it comes from down the left, as cards: the Workshop's, then each game you
    can mount, in its Steam art (installed first). What's there on the right, as tiles like the
    menu's package tiles. Picking one closes it and hands it back.
*@
<root>

	<div class="window">

		@* The frame holds the fade at its foot - a mask on the scrolling list itself would scroll with it *@
		<div class="sources-frame">
		<div class="sources">

			<div class="source workshop @(ActiveTab == Workshop ? "active" : "")" onclick=@( () => SetTab( Workshop ) )>
				<div class="art blueprint"></div>
				<div class="text">
					<label class="name">Workshop</label>
					<label class="meta">Maps made by the community</label>
				</div>
			</div>

			@* The games you have first - then the rest s&box can mount, if you had them *@
			@foreach ( var group in BaseGameMount.All.GroupBy( x => x.IsInstalled ).OrderByDescending( x => x.Key ) )
			{
				<div class="eyebrow">
					<icon>@(group.Key ? "sports_esports" : "extension")</icon>
					<label>@(group.Key ? "Installed games" : "Supported games")</label>
				</div>

				@foreach ( var mount in group )
				{
					var key = $"mount:{mount.Ident}";
					var state = mount.IsMounted ? (ActiveTab == key ? "active" : "") : "off";

					<div class="source game @state" onclick=@( () => SetTab( key, mount ) )>
						<div class="art" style="background-image: url( @(Global.IsApiConnected ? mount.CapsuleUrl : null) )"></div>
						<div class="text">
							<label class="name">@mount.Title</label>
							<label class="meta">@MetaOf( mount )</label>
						</div>
					</div>
				}
			}

		</div>
		</div>

		<div class="main">

			<div class="head">
				<div class="text">
					<label class="eyebrow-label">Pick a map</label>
					<label class="title">@TabTitle</label>
				</div>
				<div class="grow"></div>

				@* The one search, for whichever's showing - the Workshop's goes to its list, a game's filters its maps here *@
				<TextEntry class="picker-search" Text=@Search OnTextEdited=@OnSearchEdited Icon="search" Placeholder=@SearchHint />
			</div>

			<div class="body">
				@if ( ActiveTab == Workshop )
				{
					@* The menu's own package cards - hover preview and all, like everywhere else maps are listed *@
					<MenuProject.UI.PackageList @ref="WorkshopList" Surface="mappicker" ShowFilters="@true" ShowSearch="@false" Query="type:map sort:trending" Take=@(200) OnSelected=@OnSelectPackage />
				}
				else if ( ActiveMount is { } mount )
				{
					var scenes = Scenes( mount ).Where( x => MatchesSearch( x.Name ) ).OrderBy( x => x.Name ).ToList();

					if ( scenes.Count == 0 )
					{
						<div class="none">
							<i>search_off</i>
							<label>@(string.IsNullOrEmpty( Search ) ? $"{mount.Title} has no maps" : $"No maps matching \"{Search}\"")</label>
						</div>
					}
					else
					{
						<VirtualGrid ItemSize=@(new Vector2( 288, 162 )) Items=@(scenes)>
							<Item Context="item">
								@if ( item is ResourceLoader scene )
								{
									<MapTile Title="@scene.Name" Thumbnail="@((scene as IThumbnailProvider)?.Thumbnail)" Tooltip="@scene.Path" OnSelect=@(() => OnSelectScene(scene.Path)) />
								}
							</Item>
						</VirtualGrid>
					}
				}
			</div>

		</div>

	</div>

</root>

@code
{
	const string Workshop = "workshop";

	public string ActiveTab { get; set; } = Workshop;

	BaseGameMount ActiveMount => ActiveTab.StartsWith( "mount:" ) ? Directory.Get( ActiveTab["mount:".Length..] ) : null;

	string TabTitle => ActiveMount?.Title ?? "Workshop";

	string SearchHint => ActiveMount is { } mount ? $"Search {mount.Title}" : "Search the Workshop";

	MenuProject.UI.PackageList WorkshopList;

	void SetTab( string tab, BaseGameMount mount = null )
	{
		// A game that isn't mounted has nothing to show yet
		if ( mount is not null && !mount.IsMounted ) return;

		ActiveTab = tab;
		Search = null;
		StateHasChanged();
	}

	IEnumerable<ResourceLoader> Scenes( BaseGameMount mount ) => mount.GetAll( ResourceType.Scene ).Where( x => !IsHidden( x ) );

	/// <summary>
	/// Under a game's name - how many maps it has, or why it has none to give.
	/// </summary>
	string MetaOf( BaseGameMount mount )
	{
		if ( mount.IsMounted )
		{
			var count = Scenes( mount ).Count();
			return count == 1 ? "1 map" : $"{count:N0} maps";
		}

		return mount.IsInstalled ? "Not mounted" : "Not installed";
	}

	public string Search { get; set; }

	[Parameter] public Action<string> OnSelected { get; set; }

	public void SetSelected( string map )
	{
		var isMounted = MountUtility.TryParse( map, out string ident )
			&& Directory.Get( ident ) is { IsMounted: true };

		ActiveTab = isMounted ? $"mount:{ident}" : Workshop;
		StateHasChanged();
	}

	public void OnSelectPackage( Package package )
	{
		CloseModal(true);
		OnSelected?.Invoke( package.FullIdent );
	}

	public void OnSelectScene( string path )
	{
		CloseModal(true);
		OnSelected?.Invoke(path);
	}

	void OnSearchEdited( string value )
	{
		Search = value;

		// The Workshop's list searches itself - no redraw here, which would hand it its starting
		// query again and lose its filters
		if ( ActiveMount is null )
		{
			WorkshopList?.Search( value );
			return;
		}

		StateHasChanged();
	}

	bool IsHidden( ResourceLoader resource )
	{
		if ( resource.Flags.Contains( ResourceFlags.DeveloperOnly ) )
			return true;

		return false;
	}

	bool MatchesSearch( string name )
	{
		if ( string.IsNullOrEmpty( Search ) )
			return true;
		return name.Contains( Search, StringComparison.OrdinalIgnoreCase );
	}
}
