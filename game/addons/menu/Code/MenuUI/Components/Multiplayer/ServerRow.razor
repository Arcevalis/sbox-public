@using Sandbox.UI;
@using Sandbox;
@using Sandbox.Network;

<root class="row @RowClass" onclick=@OpenServerModal>

	<div class="title">
		<label class="server-name">@Server.Name</label>
		@if ( !string.IsNullOrWhiteSpace( Server.Map ) )
		{
			<label class="server-map" onclick=@OpenMapInfo>@(MapPackage?.Title ?? Server.Map)</label>
		}
	</div>
	<div class="map" onclick=@OpenMapInfo>
		@if ( MapPackage is not null || !string.IsNullOrEmpty( Server.Map ) )
		{
			@if ( string.IsNullOrEmpty( MapPackage?.Thumb ) )
			{
				<i>map</i>
			}
			else
			{
				<img src="@MapPackage.Thumb" />
			}

			<label>@(MapPackage?.Title ?? Server.Map)</label>
		}
	</div>
	<div class="members">
		<div class="current">@Server.Members</div>
		<div class="sep">/</div>
		<div class="maxmembers">@Server.MaxMembers</div>
	</div>
	<div class="ping-icon @PingClass">
		@if ( Server.Ping >= 0 )
		{
			<i>@PingIcon</i>
		}
	</div>
	<div class="ping-value @PingClass" tooltip="@PingTooltip">
		@if ( Server.Ping >= 0 )
		{
			<label>@Server.Ping</label>
		}
		else
		{
			<label>—</label>
		}
	</div>

</root>

@code
{
	/// <summary>
	/// Latest server details supplied by the live server list.
	/// </summary>
	public LobbyInformation Server { get; set; }

    Package MapPackage;
	string loadedMap;

	protected override async Task OnParametersSetAsync()
	{
		if ( loadedMap == Server.Map ) return;
		loadedMap = Server.Map;
		MapPackage = null;

		if ( string.IsNullOrEmpty( Server.Map ) || !Server.Map.Contains( '.' ) || Server.Map.Contains( ".vmap" ) ) return;

		var map = Server.Map;
		var package = await Package.FetchAsync( map, true );
		if ( IsValid && !IsDeleting && map == Server.Map && (package?.Public ?? false) )
		{
			MapPackage = package;
		}
	}

    void OpenServerModal()
    {
        ModalSystem.Instance.Server( Server );
    }

    void OpenMapInfo( PanelEvent e )
    {
        if ( MapPackage is null ) return;

		e.StopPropagation();
		ModalSystem.Instance.Map( MapPackage.FullIdent );
    }

	protected override int BuildHash() => System.HashCode.Combine( Server.Name, Server.Map, Server.Members, Server.MaxMembers, Server.Ping, MapPackage?.Thumb, MapPackage?.Title );

	string PingTooltip => Server.Ping < 0 ? "Latency unavailable" : $"{Server.Ping} ms latency";

	string RowClass => Server.IsFull ? "full" : Server.Members == 0 ? "empty" : "";

	string PingClass
	{
		get
		{
			if ( Server.Ping < 0 ) return "unknown";
			if ( Server.Ping < 50 ) return "good";
			if ( Server.Ping < 100 ) return "okay";
			return "bad";
		}
	}

	string PingIcon
	{
		get
		{
			if ( Server.Ping < 50 ) return "signal_cellular_alt";
			if ( Server.Ping < 100 ) return "signal_cellular_alt_2_bar";
			return "signal_cellular_alt_1_bar";
		}
	}
}
