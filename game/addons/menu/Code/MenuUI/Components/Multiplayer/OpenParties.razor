@using Sandbox;
@using MenuProject.Multiplayer;
@using Sandbox.UI
@inherits Panel

<root>
	<Sandbox.UI.Toolbar>
		<ChildContent>
			<TextEntry class="toolbar-search" Placeholder="Search parties" Value:bind=@search HasClearButton=@true />
			<Button class="refresh icon-only" Icon="refresh" disabled=@loading onclick=@Refresh title="Refresh parties" tooltip="Refresh parties" />
		</ChildContent>
	</Sandbox.UI.Toolbar>
	@if ( !string.IsNullOrEmpty( error ?? PartyService.Error ) )
	{
		<div class="party-error">@(error ?? PartyService.Error)</div>
	}
	@if ( VisibleParties.Length == 0 )
	{
		<div class="party-empty">
			<icon>group_add</icon>
			<label>@(loading && !loaded ? "Looking for parties…" : string.IsNullOrWhiteSpace( search ) ? "No open parties right now" : "No matching parties")</label>
			<span>@(string.IsNullOrWhiteSpace( search ) ? "Start a party, invite friends, and find something to play." : "Try another party, host, or game name.")</span>
			@if ( !string.IsNullOrWhiteSpace( search ) )
			{
				<Button class="clear-search" onclick=@(() => search = "")>Clear search</Button>
			}
			else if ( PartyRoom.Current is null && !loading )
			{
				<Button class="primary" Icon="add" disabled=@PartyService.Busy onclick=@PartyService.Create>Create a party</Button>
			}
		</div>
	}
	else
	{
		<VirtualList class="party-list" Items=@(VisibleParties.Cast<object>()) ItemHeight=@MultiplayerListRow.Height>
			<Item Context="item">
				@if ( item is PartyRoom.Entry party )
				{
					var host = new Friend( party.OwnerId ).Name;

					var isCurrentParty = party.Id == PartyRoom.Current?.Id.ValueUnsigned;

					<MultiplayerListRow Title=@($"{host}'s party") Image=@($"avatar:{party.OwnerId}")
						Subtitle=@(string.IsNullOrWhiteSpace( party.GameTitle ) ? "Deciding together" : party.GameTitle)
						PlayerCount=@party.Members CountCaption=@(isCurrentParty ? "Your party" : null)>
						<Actions>
							@if ( !isCurrentParty )
							{
								<Button disabled=@(PartyService.Busy || PartyRoom.Current is not null) onclick=@(() => PartyService.Join( party )) tooltip="@(PartyRoom.Current is null ? "Join this party" : "Leave your current party before joining another")">Join</Button>
							}
						</Actions>
					</MultiplayerListRow>
				}
			</Item>
		</VirtualList>
	}
	<Sandbox.UI.StatusBar @ref="statusBar" />
</root>

@code
{
	PartyRoom.Entry[] parties = [];
	PartyRoom lastParty;
	Sandbox.UI.StatusBar statusBar;

	bool loading;
	bool loaded;
	string error;
	string search = "";
	double nextRefresh;

	protected override void OnAfterTreeRender( bool firstTime )
	{
		base.OnAfterTreeRender( firstTime );

		if ( !statusBar.Left.Children.Any() )
		{
			statusBar.AddLeft( new Label( "Public parties · Everyone welcome" ), stretch: 1 );
		}
	}

	// Discovery is for groups still forming; active sessions belong in Active Games.
	PartyRoom.Entry[] VisibleParties => parties
		.Where( x => !x.IsPlaying )
		.Where( MatchesSearch )
		.ToArray();

	/// <summary>
	/// Match the visible party details, including a host or game name.
	/// </summary>
	bool MatchesSearch( PartyRoom.Entry party )
	{
		var query = search.Trim();

		return query.Length == 0
			|| new Friend( party.OwnerId ).Name?.Contains( query, StringComparison.OrdinalIgnoreCase ) == true
			|| party.GameTitle?.Contains( query, StringComparison.OrdinalIgnoreCase ) == true;
	}

	/// <summary>
	/// Refresh open parties while this component is visible.
	/// </summary>
	public override void Tick()
	{
		base.Tick();

		// Refresh discovery when we create, join, or leave a party.
		if ( lastParty != PartyRoom.Current )
		{
			lastParty = PartyRoom.Current;
			nextRefresh = 0;
		}

		if ( IsVisible && !loading && RealTime.Now >= nextRefresh ) _ = Refresh();
	}

	async Task Refresh()
	{
		if ( loading ) return;

		loading = true;
		nextRefresh = RealTime.Now + 15;

		try
		{
			var found = await PartyRoom.Find();
			if ( !IsValid || IsDeleting ) return;

			parties = found.Where( x => !x.IsFull && x.OwnerId != 0 && !new Friend( x.OwnerId ).IsBlocked )
				.OrderByDescending( x => x.Members ).ToArray();
			loaded = true;
			error = null;
		}
		catch ( Exception e )
		{
			error = $"Could not load parties: {e.Message}";
		}
		finally
		{
			loading = false;
			if ( IsValid && !IsDeleting ) StateHasChanged();
		}
	}

	protected override int BuildHash() => HashCode.Combine( parties, loading, error, search, PartyService.Error, PartyService.Busy, PartyRoom.Current?.Id );
}
