@using System;
@using System.Linq;
@using MenuProject;
@using MenuProject.MenuUI.Popups;
@using Sandbox;
@using Sandbox.UI;
@inherits Panel

<root>

    @if ( !HasFriends )
    {
        @* Nobody on the list at all - say what it's for, and give them a way to fill it *@
        <div class="no-friends">
            <icon>group_add</icon>
            <label class="title">No friends yet</label>
            <label class="hint">Friends you add on Steam show up here - see what they're playing, and jump into their game or party.</label>
        </div>
    }
    else
    {
        <div class="head">
            <div class="search">
                <icon>search</icon>
                <TextEntry Placeholder="Search friends.." HasClearButton=@true OnTextEdited=@OnSearchEdited />
            </div>
        </div>
    }

    @if ( HasFriends && Items.Count == 0 )
    {
        <div class="empty">
            <label>No friends called "@Search"</label>
        </div>
    }
    else if ( HasFriends )
    {
        @* One flat list of headers, party cards and rows - only what's on screen gets built *@
        <MixedVirtualList @ref="ListPanel" class="rows" Items=@Items ItemHeight=@HeightOf>
            <Item Context="item">
                @if ( item is HeadItem head )
                {
                    <div class="group-head" onmousedown=@( () => ToggleSection( head.Id ) )>
                        <icon>@(head.Collapsed ? "chevron_right" : "expand_more")</icon>
                        <label class="group-title">@head.Title</label>
                        <label class="group-count">@head.Count</label>
                    </div>
                }
                else if ( item is PartyItem partyItem )
                {
                    var party = partyItem.Party;

                    <div class="party @(party.IsMine ? "mine" : "")">
                        @if ( partyItem.Art is { } partyArt )
                        {
                            <div class="game-art" style="background-image: url( @partyArt );"></div>
                        }
                        <div class="party-main">
                            @* What it is up top - whose, how big, what they're doing - so however many are in it, none of that moves *@
                            <div class="party-info">
                                <div class="party-title">
                                    <label class="party-name">@party.Title</label>
                                    <label class="party-count">@party.Size</label>
                                </div>
                                <div class="party-game">
                                    <label class="game">@party.Game</label>
                                    @if ( party.Joinable is not null )
                                    {
                                        <label class="state">· Joinable</label>
                                    }
                                </div>
                            </div>

                            @* Who's in it underneath - as many faces as fit, then how many more *@
                            @{
                                var faces = PartyFaces( party );
                                var more = party.Size - faces.Count;
                            }

                            <div class="party-avatars">
                                @foreach ( var member in faces )
                                {
                                    <div class="avatar @(Searching && IsSearchMatch( member ) ? "match" : "")" tooltip="@member.Name" style="background-image: url( avatar:@member.Id )" onmousedown=@( ( e ) => ShowPopup( e, member ) ) />
                                }
                                @if ( more > 0 )
                                {
                                    <label class="more" tooltip="@MoreTooltip( party, faces )">+@more</label>
                                }
                            </div>
                        </div>

                        @* Beside all of it, halfway down the card *@
                        @if ( party.Joinable is { } host )
                        {
                            <div class="action join" tooltip="Join" onmousedown=@( ( e ) => Join( e, host ) )><icon>play_arrow</icon></div>
                        }
                    </div>
                }
                else if ( item is FriendItem friendItem )
                {
                    var row = friendItem.Row;

                    @* Rows with art next to each other join up - only the ends of a run get rounded corners *@
                    <div class="friend @row.StatusClass @friendItem.Joined" onmousedown=@( ( e ) => ShowPopup( e, row ) )>
                        @* The game they're in, faded in behind the row - or a blueprint if they're making one *@
                        @if ( row.InEditor )
                        {
                            <div class="editor-art"></div>
                        }
                        else if ( friendItem.Art is { } art )
                        {
                            <div class="game-art" style="background-image: url( @art );"></div>
                        }
                        <div class="avatar" style="background-image: url( avatar:@row.Id )" />
                        <div class="info">
                            <label class="name">@row.Name</label>
                            <label class="status">@row.Status</label>
                        </div>
                        <div class="grow" />
                        @if ( row.Joinable )
                        {
                            <div class="action join" tooltip="Join" onmousedown=@( ( e ) => Join( e, row ) )><icon>play_arrow</icon></div>
                        }
                        else if ( row.CanInvite )
                        {
                            var invited = RecentlyInvited( row.Id );
                            <div class="invite @(invited ? "sent" : "")" tooltip="@(invited ? "Invite sent" : "Invite to party")" onmousedown=@( ( e ) => Invite( e, row ) )>
                                <icon>@(invited ? "check" : "add")</icon>
                            </div>
                        }
                    </div>
                }
            </Item>
        </MixedVirtualList>
    }

</root>

@code
{
    /// <summary>
    /// One friend, snapshotted so we don't hit Steam every frame.
    /// </summary>
    record FriendRow( Friend Friend, ulong Id, string Name, string Status, string StatusClass, bool Joinable, bool CanInvite, string GameIdent, bool InEditor );

    /// <summary>
    /// A party one or more of our friends are in, grouped by their shared party_id.
    /// </summary>
    record PartyGroup( string Title, int Size, int Max, List<FriendRow> Members, string Game, FriendRow Joinable, bool IsMine )
    {
        // By who's in it, not which list they're in - so a refresh that changes nothing leaves the card alone
        public virtual bool Equals( PartyGroup other ) => other is not null
            && Title == other.Title && Size == other.Size && Max == other.Max && Game == other.Game
            && Joinable == other.Joinable && IsMine == other.IsMine && Members.SequenceEqual( other.Members );

        public override int GetHashCode() => HashCode.Combine( Title, Size, Max, Game, IsMine, Members.Count );
    }

    /// <summary>
    /// Most faces a party card shows before the rest become "+N" - what fits across the rail.
    /// </summary>
    const int MaxPartyFaces = 8;

    /// <summary>
    /// The friends to show faces for - whoever you searched for first, so they're never the ones cut off.
    /// </summary>
    List<FriendRow> PartyFaces( PartyGroup party ) => party.Members
        .OrderByDescending( x => Searching && IsSearchMatch( x ) )
        .Take( MaxPartyFaces )
        .ToList();

    /// <summary>
    /// Who's behind the "+N" - the friends that didn't fit, then however many we don't know.
    /// </summary>
    static string MoreTooltip( PartyGroup party, List<FriendRow> shown )
    {
        var hidden = party.Members.Except( shown ).Select( x => x.Name ).ToList();
        var strangers = party.Size - party.Members.Count;

        if ( strangers > 0 )
            hidden.Add( strangers == 1 ? "1 other" : $"{strangers} others" );

        return string.Join( ", ", hidden );
    }

    record Section( string Id, string Title, int Count, List<PartyGroup> Parties, List<FriendRow> Friends );

    //
    // What goes in the list, one after the other. Each only gets rebuilt when it stops being equal to
    // what it was - so everything a cell shows that can change lives in its item.
    //

    record HeadItem( string Id, string Title, int Count, bool Collapsed );
    record PartyItem( PartyGroup Party, string Art );
    record FriendItem( FriendRow Row, string Art, string Joined );

    /// <summary>
    /// How tall each kind of item is - the list lays out from these, so they're pinned in the
    /// stylesheet to match (the party card's 92px plus its 2px and 6px margins).
    /// </summary>
    const float HeadHeight = 36f;
    const float PartyHeight = 100f;
    const float FriendHeight = 42f;

    static readonly Func<object, float> HeightOf = item => item switch
    {
        HeadItem => HeadHeight,
        PartyItem => PartyHeight,
        _ => FriendHeight,
    };

    List<object> Items = new();
    MixedVirtualList ListPanel;
    string Search;

    /// <summary>
    /// Sections the player has folded away. Remembered for the session.
    /// </summary>
    static readonly HashSet<string> Collapsed = new();

    /// <summary>
    /// When we last invited each friend - the button shows a tick for a bit, and won't spam them.
    /// </summary>
    readonly Dictionary<ulong, RealTimeSince> Invited = new();
    const float InviteCooldown = 5f;

    const float RefreshInterval = 3f;
    RealTimeSince TimeSinceRefresh = RefreshInterval;
    bool _lastStreamerMode = Preferences.StreamerMode;

    /// <summary>
    /// Anyone on the list at all, online or not. Assumed until the first refresh says otherwise, so a
    /// full list doesn't flash up the empty state while it loads.
    /// </summary>
    bool HasFriends = true;

    public override void Tick()
    {
        base.Tick();

        if ( !IsVisible ) return;

        // Streamer mode changes friend names, so refresh straight away
        if ( Preferences.StreamerMode != _lastStreamerMode )
        {
            _lastStreamerMode = Preferences.StreamerMode;
            Refresh();
        }

        // Cells on screen show some things that aren't in their items - invite ticks, who matched the
        // search - so re-render them when those change
        var cellHash = HashCode.Combine( Invited.Count( x => x.Value < InviteCooldown ), Search );
        if ( cellHash != _cellHash )
        {
            _cellHash = cellHash;
            ListPanel?.RefreshCells();
        }

        if ( TimeSinceRefresh < RefreshInterval ) return;
        Refresh();
    }

    int _cellHash;

    [Event( "friend.change" )]
    void OnFriendChanged( Friend friend )
    {
        // Coalesce - a burst of persona changes shouldn't rebuild the list for each one
        if ( TimeSinceRefresh > 0.5f )
            TimeSinceRefresh = RefreshInterval;
    }

    void OnSearchEdited( string text )
    {
        Search = text?.Trim();
        Refresh();
    }

    bool Searching => !string.IsNullOrWhiteSpace( Search );

    /// <summary>
    /// Everyone matches when we're not searching.
    /// </summary>
    bool IsSearchMatch( FriendRow row ) => !Searching || (row.Name?.Contains( Search, StringComparison.OrdinalIgnoreCase ) ?? false);

    void ToggleSection( string id )
    {
        if ( !Collapsed.Remove( id ) )
            Collapsed.Add( id );

        Refresh();
    }

    void Refresh()
    {
        TimeSinceRefresh = 0;

        var friends = MenuUtility.Friends.Where( x => !x.IsMe ).ToList();
        HasFriends = friends.Count > 0;

        var sections = new List<Section>();

        // Group before filtering - searching for one person still shows the whole party they're in
        var playing = friends.Where( x => x.IsOnline && x.IsPlayingThisGame ).ToList();
        if ( playing.Count > 0 )
        {
            var (parties, solo) = GroupParties( playing );
            parties = parties.Where( x => x.Members.Any( IsSearchMatch ) ).ToList();
            solo = solo.Where( IsSearchMatch ).ToList();

            var count = parties.Sum( x => x.Members.Count ) + solo.Count;
            if ( count > 0 )
                sections.Add( new Section( "playing", "Playing s&box", count, parties, solo ) );
        }

        var online = friends.Where( x => x.IsOnline && !x.IsPlayingThisGame ).OrderBy( x => x.Name ).Select( ToRow ).Where( IsSearchMatch ).ToList();
        if ( online.Count > 0 )
            sections.Add( new Section( "online", "Online", online.Count, new(), online ) );

        var offline = friends.Where( x => !x.IsOnline ).OrderBy( x => x.Name ).Select( ToRow ).Where( IsSearchMatch ).ToList();
        if ( offline.Count > 0 )
            sections.Add( new Section( "offline", "Offline", offline.Count, new(), offline ) );

        Items = Flatten( sections );
        StateHasChanged();
    }

    /// <summary>
    /// Each section's header, then - unless it's folded away - its parties and its friends.
    /// </summary>
    List<object> Flatten( List<Section> sections )
    {
        var items = new List<object>();

        foreach ( var section in sections )
        {
            var collapsed = Collapsed.Contains( section.Id );
            items.Add( new HeadItem( section.Id, section.Title, section.Count, collapsed ) );

            if ( collapsed ) continue;

            foreach ( var party in section.Parties )
                items.Add( new PartyItem( party, GameArt( party.Members.FirstOrDefault()?.GameIdent ) ) );

            for ( int i = 0; i < section.Friends.Count; i++ )
            {
                var row = section.Friends[i];
                items.Add( new FriendItem( row, row.InEditor ? null : GameArt( row.GameIdent ), JoinedClasses( section.Friends, i ) ) );
            }
        }

        return items;
    }

    /// <summary>
    /// Friends that share a party get one card between them. So does a friend in a party of strangers -
    /// the size comes from their rich presence, so it still reads "Rick's party 3/16".
    /// </summary>
    (List<PartyGroup> Parties, List<FriendRow> Solo) GroupParties( List<Friend> friends )
    {
        var parties = new List<PartyGroup>();
        var solo = new List<FriendRow>();
        var myParty = PartyRoom.Current?.Id.ToString();

        foreach ( var group in friends.GroupBy( x => x.GetRichPresence( "party_id" ) ?? "" ) )
        {
            var members = group.OrderBy( x => x.Name ).ToList();
            var first = members[0];
            var size = Math.Max( members.Count, first.GetRichPresence( "party_size" ).ToInt( 0 ) );

            if ( string.IsNullOrEmpty( group.Key ) || size < 2 )
            {
                solo.AddRange( members.Select( ToRow ) );
                continue;
            }

            var rows = members.Select( ToRow ).ToList();
            var isMine = group.Key == myParty;
            var host = rows.FirstOrDefault( x => x.Joinable );

            parties.Add( new PartyGroup(
                Title: isMine ? "Your party" : PartyTitle( first ),
                Size: size,
                Max: first.GetRichPresence( "party_max" ).ToInt( PartyDeck.MAX_MEMBERS ),
                Members: rows,
                Game: GameTitle( first ),
                Joinable: isMine ? null : host,
                IsMine: isMine ) );
        }

        parties = parties
            .OrderByDescending( x => x.IsMine )
            .ThenByDescending( x => x.Joinable is not null )
            .ThenByDescending( x => x.Size )
            .ToList();

        // Joinable first, then whoever's in a game, then the menu idlers
        solo = solo
            .OrderByDescending( x => x.Joinable )
            .ThenBy( x => x.Status == "In main menu" )
            .ThenBy( x => x.Name )
            .ToList();

        return (parties, solo);
    }

    static string PartyTitle( Friend member )
    {
        var owner = member.GetRichPresence( "party_owner" ).ToULong( 0 );
        if ( owner == 0 ) return $"{member.Name}'s party";

        var friend = new Friend( owner );
        if ( friend.IsMe ) return "Your party";

        // Steam only tells us names for friends and people we've crossed paths with
        var name = friend.Name;
        return string.IsNullOrWhiteSpace( name ) || name == "[unknown]" ? $"{member.Name}'s party" : $"{name}'s party";
    }

    static bool InEditor( Friend friend ) => friend.GetRichPresence( "in_editor" ) == "1";

    static string GameTitle( Friend friend )
    {
        if ( InEditor( friend ) ) return "In the editor";

        var game = friend.GetRichPresence( "gametitle" );
        if ( string.IsNullOrWhiteSpace( game ) || game == "menu" ) return "Main menu";
        return game;
    }

    FriendRow ToRow( Friend friend )
    {
        var joinable = friend.IsPlayingThisGame && MenuHelpers.HasAuthority
            && !string.IsNullOrWhiteSpace( friend.GetRichPresence( "connect" ) );

        return new FriendRow( friend, friend.Id, friend.Name, StatusText( friend ), StatusClass( friend ), joinable,
            !joinable && MenuUtility.CanInviteToParty( friend ), PlayingIdent( friend ),
            friend.IsPlayingThisGame && InEditor( friend ) );
    }

    /// <summary>
    /// Is anything drawn behind this row - a game's screenshot, or the editor's grid.
    /// </summary>
    bool HasArt( FriendRow row ) => row.InEditor || GameArt( row.GameIdent ) is not null;

    /// <summary>
    /// "joined-top" if the row above has art too, "joined-bottom" if the row below does - so a run of
    /// them reads as one block, square where they meet, rounded only at its ends.
    /// </summary>
    string JoinedClasses( List<FriendRow> rows, int index )
    {
        if ( !HasArt( rows[index] ) ) return "";

        var top = index > 0 && HasArt( rows[index - 1] );
        var bottom = index < rows.Count - 1 && HasArt( rows[index + 1] );

        return $"{(top ? "joined-top" : "")} {(bottom ? "joined-bottom" : "")}";
    }

    /// <summary>
    /// The game they're actually in - not the menu, not the editor. Null otherwise.
    /// </summary>
    static string PlayingIdent( Friend friend )
    {
        if ( !friend.IsPlayingThisGame || InEditor( friend ) ) return null;

        var title = friend.GetRichPresence( "gametitle" );
        if ( string.IsNullOrWhiteSpace( title ) || title == "menu" ) return null;

        var ident = friend.GetRichPresence( "gamename" );
        return string.IsNullOrWhiteSpace( ident ) ? null : ident;
    }

    //
    // A screenshot of each game people are in, fetched once per game and shared by every row showing it
    //

    static readonly Dictionary<string, string> _gameArt = new();
    static readonly HashSet<string> _gameArtLoading = new();

    /// <summary>
    /// The picture to put behind a row for this game - null until it's loaded (it fetches the first time
    /// it's asked for), or if there isn't one.
    /// </summary>
    string GameArt( string ident )
    {
        if ( string.IsNullOrWhiteSpace( ident ) ) return null;
        if ( _gameArt.TryGetValue( ident, out var url ) ) return url;

        if ( _gameArtLoading.Add( ident ) )
            _ = LoadGameArt( ident );

        return null;
    }

    async Task LoadGameArt( string ident )
    {
        try
        {
            // Full details, not partial - the screenshots only come with those
            var package = await Package.FetchAsync( ident, false );
            _gameArt[ident] = PackageArt.Background( package );
        }
        catch ( Exception )
        {
            _gameArt[ident] = null;
        }

        _gameArtLoading.Remove( ident );

        // The art's part of each row's item, and it changes which rows join up - rebuild them
        if ( this.IsValid() )
            Refresh();
    }

    static string StatusText( Friend friend )
    {
        if ( friend.IsPlayingThisGame )
        {
            var game = GameTitle( friend );
            return game is "Main menu" ? "In main menu" : game is "In the editor" ? game : $"Playing {game}";
        }

        if ( !friend.IsOnline ) return "Offline";
        if ( friend.IsPlayingAGame ) return "Playing another game";
        if ( friend.IsAway || friend.IsSnoozing ) return "Away";
        if ( friend.IsBusy ) return "Busy";
        return "Online";
    }

    static string StatusClass( Friend friend )
    {
        if ( friend.IsPlayingThisGame ) return "ingame";
        if ( !friend.IsOnline ) return "offline";
        if ( friend.IsAway || friend.IsBusy || friend.IsSnoozing ) return "away";
        return "online";
    }

    bool RecentlyInvited( ulong id ) => Invited.TryGetValue( id, out var t ) && t < InviteCooldown;

    async void Invite( PanelEvent e, FriendRow row )
    {
        e.StopPropagation();
        if ( RecentlyInvited( row.Id ) ) return;

        Sound.Play( "ui.button.press" );
        Invited[row.Id] = 0;
        StateHasChanged();

        await PartyDeck.EnsureLobbyExists();
        MenuUtility.InviteToParty( row.Id );
    }

    void Join( PanelEvent e, FriendRow row )
    {
        e.StopPropagation();
        if ( !MenuHelpers.HasAuthority ) return;

        MenuUtility.JoinFriendGame( row.Friend );
    }

    Popup FriendMenu;

    void ShowPopup( PanelEvent e, FriendRow row )
    {
        e.StopPropagation();

        if ( FriendMenu.IsValid() )
        {
            var same = FriendMenu is FriendCard open && open.Friend.Id == row.Id;
            FriendMenu.Delete();
            if ( same ) return;
        }

        Popup.CloseAll();

        // The rail's against the right edge of the screen - open to the left of it, level with whatever
        // was clicked. The popup measures its offset from the source's left edge, so push it out by
        // however far that is from the rail's own - a party avatar and a row then open in the same place.
        var source = e.This ?? this;
        var offset = (source.Box.Rect.Left - Box.Rect.Left) * source.ScaleFromScreen + PopupGap;

        FriendMenu = FriendCard.Show( source, row.Friend, Popup.PositionMode.Left, offset );
    }

    /// <summary>
    /// Space between the rail's left edge and the friend card.
    /// </summary>
    const float PopupGap = 12f;
}
