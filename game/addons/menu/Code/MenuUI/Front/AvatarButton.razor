@using System;
@using Sandbox;
@using Sandbox.UI;
@using MenuProject.MenuUI.Front;
@inherits Panel

<root>

    @* A scene behind your citizen *@
    <div class="backdrop"></div>

    @* Your citizen, filling the card - spin them round, and they watch the cursor *@
    <CitizenPreview class="portrait" LocalUser="@true" Interactive="@true" />

    <div class="info">
        <label class="eyebrow">Welcome back,</label>
        <label class="name">@Sandbox.Utility.Steam.PersonaName</label>
    </div>

    @* Not mid-game - editing it would pull you out of the game into the avatar scene *@
    @if ( !Game.InGame )
    {
        <div class="edit clicky" tooltip="Edit your avatar" @onclick="@OpenAvatarScene">
            <icon>emoji_people</icon>
            <label>Edit</label>
        </div>
    }

</root>

@code
{
    protected override int BuildHash() => HashCode.Combine( Game.InGame );

    void OpenAvatarScene()
    {
        var options = new SceneLoadOptions();
        options.ShowLoadingScreen = false;
        options.SetScene( "/scenes/avatar.scene" );

        Game.ActiveScene.Load( options );
    }
}
